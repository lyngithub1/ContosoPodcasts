# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo
coverage/

# Vite
apps/web/dist/

# Env & secrets — never commit
.env
.env.*
!.env.example
*.local

# Local environment coordinates for the ops scripts (subscription ids, resource
# names, endpoints). Never commit — use infra/_env.local.ps1.example as the guide.
infra/_env.local.ps1

# Runtime artifacts written by the infra/ scripts
infra/_ids.json
infra/_*.log

# Internal-only collateral — commercial sizing / ROM cost estimates.
# Must never reach a repo that may be shared with a customer.
docs/podcast-studio-mcem-cost-model.html
docs/**/*mcem*
docs/**/*cost-model*
docs/**/*-internal.*
docs/**/*pricing*
docs/**/*rom-cost*
docs/**/*sizing*

# Credentials & keys — nothing in this project needs them (all Azure access is
# managed identity), so any file matching these is a mistake.
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.jks
*.keystore
*secret*.json
*secrets*.yaml
*secrets*.yml
*credential*.json
appsettings.*.local.json

# Terraform state can embed endpoints, ids, and generated secrets.
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.*
.terraform/

# Local exports of rendered episodes (may contain unapproved content).
Podcast Studio Examples/
episodes-export/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Azure
.azure/
*.publishsettings
