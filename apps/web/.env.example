# Client-side configuration for Azure Scientific Podcast Studio (SPA).
# NEVER put secrets here. The SPA is a public client: it holds no credential.
# Users sign in with MSAL/Entra ID; the API authorizes from the token and uses
# managed identity for all Azure service access.
# Copy to `.env.local` and fill in your own tenant/app registration values.

# --- Microsoft Entra ID sign-in (optional) ---------------------------------
# Leave VITE_ENTRA_CLIENT_ID unset (or as the all-zeros placeholder) to run the
# demo identity: a role selector plus x-actor-* headers, no cloud setup needed.
# Set all three to switch the SPA to real sign-in with bearer tokens.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# The scope exposed by the API app registration.
VITE_ENTRA_API_SCOPE=api://podstudio-api/access_as_user
# Optional; defaults to the current browser origin.
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# --- Backend ----------------------------------------------------------------
# API base URL (the Container App FQDN, or the APIM façade in production).
# Leave unset to run entirely in-browser against the seeded in-memory store.
VITE_API_BASE_URL=
